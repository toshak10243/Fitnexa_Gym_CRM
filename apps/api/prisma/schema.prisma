datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  GYM_OWNER
  BRANCH_MANAGER
  FRONT_DESK
  TRAINER
  STAFF
  MEMBER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DEACTIVATED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum BranchStatus {
  ACTIVE
  INACTIVE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum DocumentType {
  ID_PROOF
  ADDRESS_PROOF
  FITNESS_CERTIFICATE
  MEDICAL_DECLARATION
  OTHER
}

enum PlanDurationType {
  DAYS
  MONTHS
  YEARS
}

enum MembershipStatus {
  PENDING
  ACTIVE
  FROZEN
  EXPIRED
  CANCELLED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  INVALID
  IMPORTED
  SKIPPED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentStatus {
  RECORDED
  VERIFIED
  REJECTED
  REVERSED
}

enum PaymentMethodType {
  CASH
  UPI
  BANK_TRANSFER
  CARD_MANUAL
  CHEQUE
  OTHER
}

enum RefundStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PROCESSED
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum LedgerEntryType {
  INVOICE_CHARGE
  PAYMENT_CREDIT
  REFUND_DEBIT
  CREDIT_NOTE
  MANUAL_ADJUSTMENT
}

/// Tenant represents a gym business enterprise in the multi-tenant system
model Tenant {
  id        String       @id @default(uuid())
  name      String       @db.VarChar(100)
  slug      String       @unique @db.VarChar(100)
  gstin     String?      @db.VarChar(15)
  pan       String?      @db.VarChar(10)
  phone     String       @db.VarChar(20)
  email     String       @db.VarChar(100)
  address   String       @db.VarChar(255)
  city      String       @db.VarChar(50)
  state     String       @db.VarChar(50)
  pincode   String       @db.VarChar(10)
  currency  String       @default("INR") @db.VarChar(10)
  timezone  String       @default("Asia/Kolkata") @db.VarChar(50)
  status    TenantStatus @default(ACTIVE)

  // White-Label Branding & Socials
  logoUrl   String?      @db.VarChar(255)
  website   String?      @db.VarChar(255)
  instagram String?      @db.VarChar(100)
  whatsapp  String?      @db.VarChar(20)

  // SaaS Subscription & Licensing
  subscriptionPlan   String    @default("TRIAL_7_DAYS") @db.VarChar(50)
  subscriptionPrice  Int       @default(0)
  subscriptionStatus String    @default("ACTIVE") @db.VarChar(20)
  planStartedAt      DateTime  @default(now())
  planExpiresAt      DateTime?
  isLifetime         Boolean   @default(false)
  paymentStatus      String    @default("PAID") @db.VarChar(20)
  paymentReference   String?   @db.VarChar(100)
  paymentMode        String?   @db.VarChar(50)

  // Modular Feature Flags (Client-level feature delegation)
  enabledModules     String[]  @default(["MEMBERS", "BILLING", "ATTENDANCE", "DEVICES", "INVENTORY", "POS", "CRM", "TRAINERS", "EXPENSES", "NOTIFICATIONS", "ANALYTICS"])

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  branches           Branch[]
  users              User[]
  auditLogs          AuditLog[]
  members            Member[]
  membershipPlans    MembershipPlan[]
  invoices           Invoice[]
  payments           Payment[]
  attendancePolicies AttendancePolicy[]
  devices            Device[]
  memberAttendances  MemberAttendance[]
  staffAttendances   StaffAttendance[]
  attendanceSessions AttendanceSession[]
  accessDecisions    AccessDecision[]

  @@map("tenants")
}

/// Branch represents a specific gym facility / location under a Tenant
model Branch {
  id           String       @id @default(uuid())
  tenantId     String
  name         String       @db.VarChar(100)
  code         String       @db.VarChar(20)
  address      String       @db.VarChar(255)
  city         String       @db.VarChar(50)
  state        String       @db.VarChar(50)
  pincode      String       @db.VarChar(10)
  phone        String       @db.VarChar(20)
  isMainBranch Boolean      @default(false)
  status       BranchStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                User[]
  members              Member[]
  membershipPlans      MembershipPlan[]
  memberMemberships    MemberMembership[]
  invoices             Invoice[]
  payments             Payment[]
  cashRegisterSessions CashRegisterSession[]
  attendancePolicies   AttendancePolicy[]
  devices              Device[]
  attendanceSessions   AttendanceSession[]
  memberAttendances    MemberAttendance[]
  staffAttendances     StaffAttendance[]
  accessDecisions      AccessDecision[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

/// User represents owners, managers, trainers, and staff members
model User {
  id               String     @id @default(uuid())
  tenantId         String?
  branchId         String?
  email            String     @unique @db.VarChar(100)
  passwordHash     String     @db.VarChar(255)
  fullName         String     @db.VarChar(100)
  phone            String     @db.VarChar(20)
  role             UserRole   @default(STAFF)
  status           UserStatus @default(ACTIVE)
  refreshTokenHash String?    @db.VarChar(255)
  mustChangePassword Boolean  @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant                    Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                    Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditLogs                 AuditLog[]
  assignedTrainerMembers    Member[]               @relation("TrainerAssignedMembers")
  memberNotes               MemberNote[]
  collectedPayments         Payment[]              @relation("PaymentCollector")
  staffAttendances          StaffAttendance[]
  approvedCorrections       AttendanceCorrection[] @relation("ApprovedAttendanceCorrections")
  requestedCorrections      AttendanceCorrection[] @relation("RequestedAttendanceCorrections")
  recordedAttendances       MemberAttendance[]     @relation("RecordedMemberAttendances")
  overriddenAccessDecisions AccessDecision[]       @relation("OverriddenAccessDecisions")
  trainerProfile            TrainerProfile?

  @@index([tenantId])
  @@index([branchId])
  @@map("users")
}

/// Immutable audit trail ledger
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  details    Json?
  ipAddress  String   @db.VarChar(50)
  userAgent  String   @db.VarChar(255)
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

/// System health check and heartbeat ledger for verification
model SystemHealthRecord {
  id        String   @id @default(uuid())
  service   String
  status    String
  metadata  Json?
  checkedAt DateTime @default(now())

  @@index([service, checkedAt])
  @@map("system_health_records")
}

/// Member represents a gym client/subscriber
model Member {
  id                 String       @id @default(uuid())
  tenantId           String
  branchId           String
  memberCode         String       @db.VarChar(50)
  fullName           String       @db.VarChar(100)
  email              String?      @db.VarChar(100)
  phone              String       @db.VarChar(20)
  altPhone           String?      @db.VarChar(20)
  photoUrl           String?      @db.VarChar(255)
  dob                DateTime?    @db.Date
  gender             Gender?
  occupation         String?      @db.VarChar(100)
  joiningDate        DateTime     @db.Date
  fitnessGoal        String?      @db.VarChar(255)
  previousExperience String?      @db.VarChar(255)
  heightCm           Float?
  weightKg           Float?
  workoutTiming      String?      @db.VarChar(50)
  assignedTrainerId  String?
  status             MemberStatus @default(ACTIVE)
  isMinor            Boolean      @default(false)
  guardianName       String?      @db.VarChar(100)
  guardianPhone      String?      @db.VarChar(20)
  guardianRelation   String?      @db.VarChar(50)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  createdBy          String?
  updatedBy          String?

  tenant             Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch                   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  assignedTrainer    User?                    @relation("TrainerAssignedMembers", fields: [assignedTrainerId], references: [id], onDelete: SetNull)
  address            MemberAddress?
  emergencyContact   MemberEmergencyContact?
  healthDeclaration  MemberHealthDeclaration?
  consent            MemberConsent?
  documents          MemberDocument[]
  memberships        MemberMembership[]
  notes              MemberNote[]
  activities         MemberActivity[]
  invoices           Invoice[]
  payments           Payment[]
  ledgerEntries      MemberAccountLedger[]
  attendances        MemberAttendance[]
  attendanceSessions AttendanceSession[]
  deviceMappings     DeviceMemberMapping[]
  accessDecisions    AccessDecision[]
  trainerAssignments TrainerAssignment[]
  trainingSessions   TrainingSession[]
  convertedFromLead  Lead?

  @@unique([tenantId, memberCode])
  @@unique([tenantId, phone])
  @@index([tenantId, status])
  @@index([tenantId, branchId])
  @@index([tenantId, fullName])
  @@map("members")
}

/// Member residential address details
model MemberAddress {
  id           String  @id @default(uuid())
  memberId     String  @unique
  addressLine1 String  @db.VarChar(255)
  addressLine2 String? @db.VarChar(255)
  city         String  @db.VarChar(50)
  state        String  @db.VarChar(50)
  pincode      String  @db.VarChar(10)
  country      String  @default("India") @db.VarChar(50)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_addresses")
}

/// Member emergency contact details
model MemberEmergencyContact {
  id           String @id @default(uuid())
  memberId     String @unique
  name         String @db.VarChar(100)
  relationship String @db.VarChar(50)
  phone        String @db.VarChar(20)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_emergency_contacts")
}

/// Member health declarations & exercise restrictions (Confidential)
model MemberHealthDeclaration {
  id                   String   @id @default(uuid())
  memberId             String   @unique
  hasHealthCondition   Boolean  @default(false)
  medicalHistory       String?  @db.Text
  exerciseRestrictions String?  @db.Text
  emergencyConsent     Boolean  @default(true)
  processingConsent    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_health_declarations")
}

/// Member consent and gym terms acknowledgement
model MemberConsent {
  id                    String   @id @default(uuid())
  memberId              String   @unique
  termsAccepted         Boolean  @default(true)
  privacyPolicyAccepted Boolean  @default(true)
  gymRulesAccepted      Boolean  @default(true)
  marketingConsent      Boolean  @default(false)
  guardianConsentGiven  Boolean?
  consentedAt           DateTime @default(now())
  ipAddress             String?  @db.VarChar(50)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_consents")
}

/// Member identity and verification documents
model MemberDocument {
  id           String       @id @default(uuid())
  memberId     String
  tenantId     String
  documentType DocumentType
  title        String       @db.VarChar(100)
  fileUrl      String       @db.VarChar(255)
  fileSize     Int
  mimeType     String       @db.VarChar(100)
  uploadedBy   String?
  createdAt    DateTime     @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId])
  @@map("member_documents")
}

/// Membership plans configured by Gym Owners
model MembershipPlan {
  id                String           @id @default(uuid())
  tenantId          String
  branchId          String?
  name              String           @db.VarChar(100)
  code              String?          @db.VarChar(50)
  description       String?          @db.Text
  durationType      PlanDurationType @default(MONTHS)
  durationValue     Int
  priceInPaise      Int
  joiningFeeInPaise Int              @default(0)
  taxRateBps        Int              @default(1800)
  isTaxInclusive    Boolean          @default(false)
  maxFreezeDays     Int              @default(0)
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch?            @relation(fields: [branchId], references: [id], onDelete: SetNull)
  memberMemberships MemberMembership[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("membership_plans")
}

/// Member's enrolled membership instance
model MemberMembership {
  id                  String           @id @default(uuid())
  memberId            String
  planId              String
  tenantId            String
  branchId            String
  startDate           DateTime         @db.Date
  endDate             DateTime         @db.Date
  pricePaidInPaise    Int
  taxPaidInPaise      Int
  status              MembershipStatus @default(PENDING)
  freezeStartDate     DateTime?        @db.Date
  freezeEndDate       DateTime?        @db.Date
  totalFreezeDaysUsed Int              @default(0)
  cancellationReason  String?          @db.Text
  cancelledAt         DateTime?
  assignedBy          String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  member        Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  branch        Branch                    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  plan          MembershipPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  statusHistory MembershipStatusHistory[]
  invoices      Invoice[]

  @@index([tenantId, status])
  @@index([memberId, status])
  @@index([endDate])
  @@map("member_memberships")
}

/// Audit log of membership status transitions
model MembershipStatusHistory {
  id                 String           @id @default(uuid())
  memberMembershipId String
  fromStatus         MembershipStatus
  toStatus           MembershipStatus
  reason             String?          @db.VarChar(255)
  changedBy          String?
  changedAt          DateTime         @default(now())

  membership MemberMembership @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)

  @@index([memberMembershipId])
  @@map("membership_status_history")
}

/// Internal notes left on member profiles by staff
model MemberNote {
  id        String   @id @default(uuid())
  memberId  String
  tenantId  String
  authorId  String?
  note      String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([tenantId, memberId])
  @@map("member_notes")
}

/// Activity timeline records for member actions
model MemberActivity {
  id          String   @id @default(uuid())
  memberId    String
  tenantId    String
  performedBy String?
  action      String   @db.VarChar(100)
  details     Json?
  createdAt   DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, createdAt])
  @@map("member_activities")
}

/// Tracking metadata for bulk member data migrations
model MemberImportBatch {
  id           String       @id @default(uuid())
  tenantId     String
  branchId     String
  fileName     String       @db.VarChar(255)
  fileSize     Int
  totalRows    Int
  validRows    Int          @default(0)
  invalidRows  Int          @default(0)
  importedRows Int          @default(0)
  status       ImportStatus @default(PENDING)
  uploadedBy   String?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  rows MemberImportRow[]

  @@index([tenantId, status])
  @@map("member_import_batches")
}

/// Individual row inside an import batch
model MemberImportRow {
  id         String          @id @default(uuid())
  batchId    String
  rowNumber  Int
  rawData    Json
  parsedData Json?
  status     ImportRowStatus @default(VALID)
  errors     Json?
  memberId   String?
  createdAt  DateTime        @default(now())

  batch MemberImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@map("member_import_rows")
}

// ========================================================
// PHASE 3: FINANCIAL & BILLING SUBSYSTEM MODELS
// ========================================================

/// Authoritative tax invoice or bill issued to a member
model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  branchId      String
  memberId      String
  membershipId  String?
  invoiceNumber String        @db.VarChar(50)
  status        InvoiceStatus @default(ISSUED)
  invoiceDate   DateTime      @db.Date
  dueDate       DateTime      @db.Date

  subtotalInPaise   Int
  discountInPaise   Int     @default(0)
  taxRateBps        Int     @default(1800) // 1800 = 18.00% GST
  taxAmountInPaise  Int     @default(0)
  isTaxInclusive    Boolean @default(false)
  grandTotalInPaise Int
  paidAmountInPaise Int     @default(0)
  balanceDueInPaise Int // grandTotal - paidAmount

  notes              String?   @db.Text
  termsAndConditions String?   @db.Text
  voidReason         String?   @db.VarChar(255)
  voidedAt           DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member      Member              @relation(fields: [memberId], references: [id], onDelete: Restrict)
  membership  MemberMembership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  lineItems   InvoiceLineItem[]
  allocations PaymentAllocation[]
  creditNotes CreditNote[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, status])
  @@index([tenantId, branchId, dueDate])
  @@index([tenantId, memberId])
  @@index([tenantId, invoiceDate])
  @@index([tenantId, branchId, invoiceDate])
  @@map("invoices")
}

/// Itemized breakdown inside an invoice
model InvoiceLineItem {
  id                 String  @id @default(uuid())
  invoiceId          String
  description        String  @db.VarChar(255)
  quantity           Int     @default(1)
  unitPriceInPaise   Int
  discountInPaise    Int     @default(0)
  taxRateBps         Int     @default(1800)
  taxAmountInPaise   Int     @default(0)
  totalAmountInPaise Int
  itemType           String  @db.VarChar(50) // PLAN, JOINING_FEE, PERSONAL_TRAINING, SERVICE, OTHER
  referenceId        String? @db.VarChar(100)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

/// Real payment transaction recorded by staff or gateway
model Payment {
  id                 String            @id @default(uuid())
  tenantId           String
  branchId           String
  memberId           String
  registerSessionId  String?
  paymentNumber      String            @db.VarChar(50)
  amountInPaise      Int
  unallocatedInPaise Int               @default(0)
  method             PaymentMethodType
  referenceNumber    String?           @db.VarChar(100)
  paymentDate        DateTime          @default(now())
  status             PaymentStatus     @default(VERIFIED)
  notes              String?           @db.Text
  collectedBy        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member          Member               @relation(fields: [memberId], references: [id], onDelete: Restrict)
  collector       User                 @relation("PaymentCollector", fields: [collectedBy], references: [id], onDelete: Restrict)
  registerSession CashRegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  allocations     PaymentAllocation[]
  receipt         PaymentReceipt?
  refunds         Refund[]

  @@unique([tenantId, paymentNumber])
  @@index([tenantId, paymentDate])
  @@index([tenantId, branchId, paymentDate])
  @@index([tenantId, memberId])
  @@index([tenantId, branchId, method])
  @@map("payments")
}

/// Attribution of a payment to a specific invoice
model PaymentAllocation {
  id               String   @id @default(uuid())
  tenantId         String
  paymentId        String
  invoiceId        String
  allocatedInPaise Int
  allocatedAt      DateTime @default(now())
  allocatedBy      String

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
}

/// Official receipt issued to the member
model PaymentReceipt {
  id            String   @id @default(uuid())
  tenantId      String
  branchId      String
  paymentId     String   @unique
  receiptNumber String   @db.VarChar(50)
  issuedAt      DateTime @default(now())
  issuedBy      String
  snapshotData  Json

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, branchId, issuedAt])
  @@map("payment_receipts")
}

/// Controlled refund against an authorized verified payment
model Refund {
  id              String       @id @default(uuid())
  tenantId        String
  branchId        String
  paymentId       String
  refundNumber    String       @db.VarChar(50)
  amountInPaise   Int
  reason          String       @db.Text
  status          RefundStatus @default(PENDING_APPROVAL)
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  processedAt     DateTime?
  payoutReference String?      @db.VarChar(100)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([tenantId, refundNumber])
  @@index([tenantId, status])
  @@map("refunds")
}

/// Credit note for invoice reduction or dispute adjustment
model CreditNote {
  id               String   @id @default(uuid())
  tenantId         String
  branchId         String
  invoiceId        String
  creditNoteNumber String   @db.VarChar(50)
  amountInPaise    Int
  reason           String   @db.Text
  issuedBy         String
  issuedAt         DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([tenantId, creditNoteNumber])
  @@map("credit_notes")
}

/// Daily cash drawer / register session tracking for front-desk staff
model CashRegisterSession {
  id                   String                @id @default(uuid())
  tenantId             String
  branchId             String
  openedBy             String
  closedBy             String?
  openedAt             DateTime              @default(now())
  closedAt             DateTime?
  openingFloatInPaise  Int
  cashCollectedInPaise Int                   @default(0)
  cashRefundedInPaise  Int                   @default(0)
  cashPaidOutInPaise   Int                   @default(0)
  expectedClosingPaise Int
  actualClosingPaise   Int?
  varianceInPaise      Int?
  status               RegisterSessionStatus @default(OPEN)
  notes                String?               @db.Text

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([tenantId, branchId, status])
  @@map("cash_register_sessions")
}

/// Double-entry style member account balance ledger
model MemberAccountLedger {
  id                  String          @id @default(uuid())
  tenantId            String
  memberId            String
  entryType           LedgerEntryType
  amountInPaise       Int
  runningBalancePaise Int
  referenceId         String          @db.VarChar(100)
  notes               String?         @db.VarChar(255)
  recordedAt          DateTime        @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([tenantId, memberId, recordedAt])
  @@map("member_account_ledgers")
}

/// Atomic sequence counter for concurrency-safe invoice and receipt numbering
model BillingSequence {
  id              String @id @default(uuid())
  tenantId        String
  sequenceType    String @db.VarChar(20) // INVOICE, RECEIPT, PAYMENT, REFUND, CREDIT_NOTE
  year            Int
  currentSequence Int    @default(0)

  @@unique([tenantId, sequenceType, year])
  @@map("billing_sequences")
}

/// Idempotency protection to prevent double billing / duplicate payment collection
model IdempotencyRecord {
  id             String   @id @default(uuid())
  tenantId       String
  idempotencyKey String   @db.VarChar(128)
  endpoint       String   @db.VarChar(100)
  requestHash    String   @db.VarChar(64)
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([tenantId, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// =========================================================================
// PHASE 4: ATTENDANCE, ACCESS CONTROL & BIOMETRIC DEVICE INTEGRATION MODELS
// =========================================================================

enum DeviceType {
  BIOMETRIC_FINGERPRINT
  FACIAL_RECOGNITION
  RFID_CARD
  BARCODE_QR
  HYBRID
}

enum DeviceConnectionType {
  LAN_ETHERNET
  WIFI
  USB
  CLOUD_PUSH_HTTP
  GATEWAY_DAEMON
}

enum DeviceDirection {
  ENTRY_ONLY
  EXIT_ONLY
  BIDIRECTIONAL
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNCONFIGURED
  DISABLED
}

enum EventIngestionStatus {
  PENDING
  PROCESSED
  DUPLICATE
  UNMAPPED_USER
  QUARANTINED
  FAILED
}

enum AccessDecisionType {
  ALLOWED
  DENIED
  OVERRIDDEN
}

enum AccessReasonCode {
  VALID_ACTIVE_MEMBERSHIP
  VALID_WITH_PENDING_DUES
  GRACE_PERIOD_ACTIVE
  MEMBERSHIP_EXPIRED
  MEMBERSHIP_FROZEN
  MEMBERSHIP_PENDING_PAYMENT
  OUTSTANDING_DUES_BLOCK
  MEMBER_ACCOUNT_SUSPENDED
  BRANCH_ACCESS_RESTRICTED
  OUTSIDE_ALLOWED_TIME_WINDOW
  DUPLICATE_TAP_IGNORED
  UNMAPPED_DEVICE_USER
  MANUAL_OVERRIDE
}

enum AttendanceDirection {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceSourceType {
  MANUAL_FRONT_DESK
  BIOMETRIC_DEVICE
  RFID_SCAN
  QR_CODE
  SYSTEM_CORRECTION
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  AUTO_CLOSED
  DISCARDED
}

enum AttendanceCorrectionType {
  INSERT_CHECKOUT
  MODIFY_TIMESTAMP
  VOID_SESSION
  MANUAL_SESSION_CREATE
}

enum CorrectionStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

/// Gym access control and attendance operational policies per branch/tenant
model AttendancePolicy {
  id                            String   @id @default(uuid())
  tenantId                      String
  branchId                      String?
  name                          String   @default("Standard Access Policy") @db.VarChar(100)
  requireActiveMembership       Boolean  @default(true)
  allowGracePeriodDays          Int      @default(0)
  restrictOnOutstandingDues     Boolean  @default(false)
  maxDuesThresholdInPaise       Int      @default(0)
  enforceBranchAccess           Boolean  @default(true)
  allowOffPeakOnly              Boolean  @default(false)
  offPeakStartMinutes           Int? // Minutes from midnight, e.g. 600 = 10:00 AM
  offPeakEndMinutes             Int? // Minutes from midnight, e.g. 1020 = 5:00 PM
  duplicateCheckinWindowMinutes Int      @default(15)
  autoCheckoutAfterHours        Int      @default(4)
  allowOwnerOverride            Boolean  @default(true)
  allowManagerOverride          Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId])
  @@map("attendance_policies")
}

/// Registry of physical biometric terminals and attendance turnstiles
model Device {
  id              String               @id @default(uuid())
  tenantId        String
  branchId        String
  name            String               @db.VarChar(100)
  deviceCode      String               @db.VarChar(50)
  deviceType      DeviceType           @default(BIOMETRIC_FINGERPRINT)
  manufacturer    String               @default("Generic / Pending Verification") @db.VarChar(100)
  modelName       String               @default("Pending Model Spec") @db.VarChar(100)
  serialNumber    String?              @db.VarChar(100)
  firmwareVersion String?              @db.VarChar(50)
  ipAddress       String?              @db.VarChar(50)
  port            Int?
  connectionType  DeviceConnectionType @default(CLOUD_PUSH_HTTP)
  direction       DeviceDirection      @default(BIDIRECTIONAL)
  status          DeviceStatus         @default(UNCONFIGURED)
  lastHeartbeatAt DateTime?
  authTokenHash   String?              @db.VarChar(255)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberMappings DeviceMemberMapping[]
  eventsInbox    DeviceEventInbox[]
  syncJobs       DeviceSyncJob[]
  syncCursor     DeviceSyncCursor?
  attendances    MemberAttendance[]

  @@unique([tenantId, deviceCode])
  @@index([tenantId, branchId, status])
  @@map("devices")
}

/// Maps member to hardware user ID on physical biometric machine (no biometric templates stored)
model DeviceMemberMapping {
  id           String    @id @default(uuid())
  tenantId     String
  branchId     String
  deviceId     String
  memberId     String
  deviceUserId String    @db.VarChar(50) // Card / enrollment number on device
  isActive     Boolean   @default(true)
  syncedAt     DateTime?
  assignedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([deviceId, deviceUserId])
  @@unique([deviceId, memberId])
  @@index([tenantId, memberId])
  @@map("device_member_mappings")
}

/// Durable staging inbox for raw device event ingestion
model DeviceEventInbox {
  id              String               @id @default(uuid())
  tenantId        String
  branchId        String
  deviceId        String
  idempotencyKey  String               @db.VarChar(128)
  deviceUserId    String               @db.VarChar(50)
  eventTimestamp  DateTime
  direction       AttendanceDirection  @default(CHECK_IN)
  rawPayload      Json
  ingestionStatus EventIngestionStatus @default(PENDING)
  processingError String?              @db.Text
  processedAt     DateTime?
  receivedAt      DateTime             @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, deviceId, ingestionStatus])
  @@index([receivedAt])
  @@map("device_event_inbox")
}

/// State of device synchronization cursors
model DeviceSyncCursor {
  id           String    @id @default(uuid())
  deviceId     String    @unique
  lastEventId  String?   @db.VarChar(100)
  lastSyncTime DateTime?
  totalSynced  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("device_sync_cursors")
}

/// Batch pull/sync background jobs
model DeviceSyncJob {
  id           String    @id @default(uuid())
  deviceId     String
  status       String    @db.VarChar(30) // PENDING, RUNNING, SUCCESS, FAILED
  eventsPulled Int       @default(0)
  eventsSaved  Int       @default(0)
  errorMessage String?   @db.Text
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, startedAt])
  @@map("device_sync_jobs")
}

/// Immutable record of access decisions made at gate/turnstile or manual desk
model AccessDecision {
  id                   String             @id @default(uuid())
  tenantId             String
  branchId             String
  memberId             String?
  deviceId             String?
  decision             AccessDecisionType
  reasonCode           AccessReasonCode
  reasonDetails        String?            @db.Text
  outstandingDuesPaise Int                @default(0)
  overriddenByUserId   String?
  overrideReason       String?            @db.Text
  timestamp            DateTime           @default(now())

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member       Member?            @relation(fields: [memberId], references: [id], onDelete: SetNull)
  overriddenBy User?              @relation("OverriddenAccessDecisions", fields: [overriddenByUserId], references: [id], onDelete: SetNull)
  attendances  MemberAttendance[]

  @@index([tenantId, timestamp])
  @@index([memberId, timestamp])
  @@map("access_decisions")
}

/// Atomic gym check-in or check-out event
model MemberAttendance {
  id               String               @id @default(uuid())
  tenantId         String
  branchId         String
  memberId         String
  sessionId        String?
  accessDecisionId String?
  deviceId         String?
  direction        AttendanceDirection
  source           AttendanceSourceType @default(MANUAL_FRONT_DESK)
  timestamp        DateTime             @default(now())
  recordedByUserId String?
  isAutoGenerated  Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member         Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session        AttendanceSession?     @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  accessDecision AccessDecision?        @relation(fields: [accessDecisionId], references: [id], onDelete: SetNull)
  device         Device?                @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  recordedBy     User?                  @relation("RecordedMemberAttendances", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  corrections    AttendanceCorrection[]

  @@index([tenantId, branchId, timestamp])
  @@index([memberId, timestamp])
  @@map("member_attendances")
}

/// Gym visit period for duration calculation and live facility occupancy tracking
model AttendanceSession {
  id                   String        @id @default(uuid())
  tenantId             String
  branchId             String
  memberId             String
  checkInAttendanceId  String?       @unique
  checkOutAttendanceId String?       @unique
  checkInTime          DateTime
  checkOutTime         DateTime?
  durationInMinutes    Int?
  status               SessionStatus @default(ACTIVE)
  closeReason          String?       @db.VarChar(50) // NORMAL_CHECKOUT, TIMEOUT_EXCEEDED, MANUAL_RECONCILIATION
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  member      Member                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  attendances MemberAttendance[]
  corrections AttendanceCorrection[]

  @@index([tenantId, branchId, status])
  @@index([memberId, status])
  @@index([checkInTime])
  @@map("attendance_sessions")
}

/// Audit ledger for retrospective attendance fixes
model AttendanceCorrection {
  id                  String                   @id @default(uuid())
  tenantId            String
  memberAttendanceId  String?
  attendanceSessionId String?
  correctionType      AttendanceCorrectionType
  originalValue       Json?
  correctedValue      Json
  reason              String                   @db.Text
  requestedByUserId   String
  approvedByUserId    String?
  status              CorrectionStatus         @default(PENDING_APPROVAL)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  attendance  MemberAttendance?  @relation(fields: [memberAttendanceId], references: [id], onDelete: SetNull)
  session     AttendanceSession? @relation(fields: [attendanceSessionId], references: [id], onDelete: SetNull)
  requestedBy User               @relation("RequestedAttendanceCorrections", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  approvedBy  User?              @relation("ApprovedAttendanceCorrections", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@map("attendance_corrections")
}

/// Dedicated attendance log for trainers, instructors, and front-desk employees
model StaffAttendance {
  id                String               @id @default(uuid())
  tenantId          String
  branchId          String
  staffId           String
  checkInTime       DateTime             @default(now())
  checkOutTime      DateTime?
  durationInMinutes Int?
  source            AttendanceSourceType @default(MANUAL_FRONT_DESK)
  status            SessionStatus        @default(ACTIVE)
  shiftDate         DateTime             @db.Date
  notes             String?              @db.VarChar(255)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)
  staff  User   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([tenantId, shiftDate])
  @@index([staffId, shiftDate])
  @@index([tenantId, branchId, status])
  @@map("staff_attendances")
}

// ============================================================================
// PHASE 5: INVENTORY, POS, TRAINERS, LEADS, EXPENSES & NOTIFICATIONS
// ============================================================================

enum ProductUnit {
  PIECES
  BOXES
  SCOOPS
  KGS
  BOTTLES
  PACKS
}

enum StockMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  POS_SALE
  ADJUSTMENT_WRITE_OFF
  ADJUSTMENT_FOUND
  INTERNAL_TRANSFER_IN
  INTERNAL_TRANSFER_OUT
  SALE_RETURN
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  COMPLETED
  CANCELLED
}

enum InventoryTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum TrainerSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LeadSource {
  WALK_IN
  WEBSITE
  PHONE_CALL
  REFERRAL
  SOCIAL_MEDIA
  CAMPAIGN
  OTHER
}

enum LeadStage {
  NEW
  CONTACTED
  FOLLOW_UP
  TRIAL_SCHEDULED
  TRIAL_COMPLETED
  CONVERTED
  LOST
}

enum LeadLostReason {
