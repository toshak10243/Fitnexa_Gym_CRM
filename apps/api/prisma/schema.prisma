// ----------------------------------------------------------------------------
// INVENTORY & STOCK MODELS
// ----------------------------------------------------------------------------

model ProductCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("product_categories")
}

model Product {
  id                  String      @id @default(uuid())
  tenantId            String
  categoryId          String
  sku                 String      @db.VarChar(100)
  barcode             String?     @db.VarChar(100)
  name                String      @db.VarChar(150)
  description         String?     @db.Text
  unit                ProductUnit @default(PIECES)
  costPriceInPaise    Int
  sellingPriceInPaise Int
  taxRatePercentage   Decimal     @default(18.0) @db.Decimal(5, 2)
  hsnCode             String?     @db.VarChar(20)
  reorderThreshold    Int         @default(5)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  category      ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  movements     StockMovement[]
  poItems       PurchaseOrderItem[]
  transferItems InventoryTransferItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, categoryId])
  @@index([tenantId, barcode])
  @@map("products")
}

model StockLocation {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(50)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements       StockMovement[]
  sourceTransfers InventoryTransfer[] @relation("SourceLocationTransfers")
  destTransfers   InventoryTransfer[] @relation("DestLocationTransfers")

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
  @@map("stock_locations")
}

model StockMovement {
  id               String            @id @default(uuid())
  tenantId         String
  branchId         String
  productId        String
  locationId       String
  movementType     StockMovementType
  quantityDelta    Int
  unitCostInPaise  Int
  referenceType    String?           @db.VarChar(50) // POS_INVOICE, PO_RECEIPT, ADJUSTMENT, TRANSFER
  referenceId      String?           @db.VarChar(100)
  notes            String?           @db.VarChar(255)
  recordedByUserId String?
  timestamp        DateTime          @default(now())

  product  Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@index([tenantId, branchId, productId])
  @@index([tenantId, locationId, timestamp])
  @@map("stock_movements")
}

model StockAdjustment {
  id               String   @id @default(uuid())
  tenantId         String
  branchId         String
  productId        String
  locationId       String
  systemQuantity   Int
  physicalQuantity Int
  quantityDelta    Int
  reason           String   @db.VarChar(255)
  approvedByUserId String?
  createdAt        DateTime @default(now())

  @@index([tenantId, branchId, createdAt])
  @@map("stock_adjustments")
}

model Supplier {
  id            String   @id @default(uuid())
  tenantId      String
  name          String   @db.VarChar(150)
  contactPerson String?  @db.VarChar(100)
  phone         String   @db.VarChar(20)
  email         String?  @db.VarChar(100)
  gstin         String?  @db.VarChar(20)
  address       String?  @db.VarChar(255)
  city          String?  @db.VarChar(50)
  state         String?  @db.VarChar(50)
  pincode       String?  @db.VarChar(10)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  expenses       Expense[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  branchId     String
  supplierId   String
  poNumber     String              @db.VarChar(50)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  status       PurchaseOrderStatus @default(DRAFT)
  totalInPaise Int                 @default(0)
  notes        String?             @db.Text
  createdBy    String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  supplier      Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items         PurchaseOrderItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String @id @default(uuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int    @default(0)
  unitCostInPaise  Int
  totalCostInPaise Int

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model GoodsReceipt {
  id               String   @id @default(uuid())
  tenantId         String
  branchId         String
  purchaseOrderId  String
  receiptNumber    String   @db.VarChar(50)
  receivedAt       DateTime @default(now())
  receivedByUserId String
  invoiceNumber    String?  @db.VarChar(100)
  notes            String?  @db.Text

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId, purchaseOrderId])
  @@map("goods_receipts")
}

model InventoryTransfer {
  id               String                  @id @default(uuid())
  tenantId         String
  transferNumber   String                  @db.VarChar(50)
  sourceBranchId   String
  sourceLocationId String
  destBranchId     String
  destLocationId   String
  status           InventoryTransferStatus @default(PENDING)
  notes            String?                 @db.Text
  transferredBy    String
  transferredAt    DateTime                @default(now())
  receivedBy       String?
  receivedAt       DateTime?

  sourceLocation StockLocation           @relation("SourceLocationTransfers", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destLocation   StockLocation           @relation("DestLocationTransfers", fields: [destLocationId], references: [id], onDelete: Restrict)
  items          InventoryTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId, status])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id         String @id @default(uuid())
  transferId String
  productId  String
  quantity   Int

  transfer InventoryTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@map("inventory_transfer_items")
}

// ----------------------------------------------------------------------------
// TRAINER MANAGEMENT MODELS
// ----------------------------------------------------------------------------

model TrainerProfile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  tenantId             String
  branchId             String?
  bio                  String?  @db.Text
  specializations      String[]
  certifications       String?  @db.Text
  commissionPercentage Int      @default(0) // Basis points (e.g. 1500 = 15%)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilities TrainerAvailability[]
  assignments    TrainerAssignment[]
  sessions       TrainingSession[]

  @@index([tenantId, isActive])
  @@map("trainer_profiles")
}

model TrainerAvailability {
  id               String  @id @default(uuid())
  trainerProfileId String
  dayOfWeek        Int // 0=Sunday, 1=Monday... 6=Saturday
  startTime        String  @db.VarChar(10) // HH:MM
  endTime          String  @db.VarChar(10) // HH:MM
  isAvailable      Boolean @default(true)

  trainerProfile TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)

  @@index([trainerProfileId, dayOfWeek])
  @@map("trainer_availabilities")
}

model TrainingPackage {
  id           String   @id @default(uuid())
  tenantId     String
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  sessionCount Int
  validityDays Int
  priceInPaise Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments TrainerAssignment[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("training_packages")
}

model TrainerAssignment {
  id                String   @id @default(uuid())
  tenantId          String
  branchId          String
  trainerProfileId  String
  memberId          String
  packageId         String
  totalSessions     Int
  remainingSessions Int
  startDate         DateTime @db.Date
  endDate           DateTime @db.Date
  isActive          Boolean  @default(true)
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  trainerProfile TrainerProfile    @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)
  member         Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  package        TrainingPackage   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  sessions       TrainingSession[]

  @@index([tenantId, trainerProfileId])
  @@index([tenantId, memberId])
  @@map("trainer_assignments")
}

model TrainingSession {
  id                 String               @id @default(uuid())
  tenantId           String
  branchId           String
  trainerProfileId   String
  memberId           String
  assignmentId       String?
  scheduledAt        DateTime
  durationMinutes    Int                  @default(60)
  status             TrainerSessionStatus @default(SCHEDULED)
  notes              String?              @db.Text
  memberAttendanceId String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  trainerProfile TrainerProfile     @relation(fields: [trainerProfileId], references: [id], onDelete: Restrict)
  member         Member             @relation(fields: [memberId], references: [id], onDelete: Restrict)
  assignment     TrainerAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, trainerProfileId, scheduledAt])
  @@index([tenantId, memberId, scheduledAt])
  @@map("training_sessions")
}

// ----------------------------------------------------------------------------
// LEAD CRM MODELS
// ----------------------------------------------------------------------------

model Lead {
  id                String          @id @default(uuid())
  tenantId          String
  branchId          String
  firstName         String          @db.VarChar(100)
  lastName          String          @db.VarChar(100)
  phone             String          @db.VarChar(20)
  email             String?         @db.VarChar(100)
  gender            Gender?
  fitnessGoal       String?         @db.VarChar(255)
  source            LeadSource      @default(WALK_IN)
  stage             LeadStage       @default(NEW)
  assignedStaffId   String?
  trialScheduledAt  DateTime?
  lostReason        LeadLostReason?
  lostNotes         String?         @db.Text
  convertedMemberId String?         @unique
  notes             String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  followUps       LeadFollowUp[]
  activities      LeadActivity[]
  convertedMember Member?        @relation(fields: [convertedMemberId], references: [id], onDelete: SetNull)

  @@index([tenantId, stage])
  @@index([tenantId, phone])
  @@index([tenantId, branchId])
  @@map("leads")
}

model LeadFollowUp {
  id          String    @id @default(uuid())
  leadId      String
  staffId     String
  scheduledAt DateTime
  completedAt DateTime?
  callType    String    @default("PHONE") @db.VarChar(30)
  outcome     String?   @db.VarChar(100)
  notes       String?   @db.Text
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, scheduledAt])
  @@map("lead_follow_ups")
}

model LeadActivity {
  id        String   @id @default(uuid())
  leadId    String
  staffId   String?
  action    String   @db.VarChar(100) // STAGE_CHANGED, CALL_LOGGED, TRIAL_BOOKED, NOTE_ADDED
  details   Json?
  timestamp DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, timestamp])
  @@map("lead_activities")
}

// ----------------------------------------------------------------------------
// EXPENSE MANAGEMENT MODELS
// ----------------------------------------------------------------------------

model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String   @db.VarChar(100)
  code        String   @db.VarChar(50)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  expenses Expense[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id                    String               @id @default(uuid())
  tenantId              String
  branchId              String
  categoryId            String
  supplierId            String?
  expenseDate           DateTime             @db.Date
  amountInPaise         Int
  paymentMethod         ExpensePaymentMethod
  payeeName             String               @db.VarChar(150)
  description           String               @db.Text
  receiptDocumentUrl    String?              @db.VarChar(255)
  status                ExpenseStatus        @default(PENDING_APPROVAL)
  cashRegisterSessionId String?
  approvedByUserId      String?
  approvedAt            DateTime?
  notes                 String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([tenantId, expenseDate])
  @@index([tenantId, branchId, status])
  @@map("expenses")
}

model RecurringExpense {
  id            String                    @id @default(uuid())
  tenantId      String
  branchId      String
  categoryId    String
  title         String                    @db.VarChar(150)
  amountInPaise Int
  frequency     RecurringExpenseFrequency @default(MONTHLY)
  dueDayOfMonth Int                       @default(1)
  isActive      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([tenantId, isActive])
  @@map("recurring_expenses")
}

// ----------------------------------------------------------------------------
// NOTIFICATIONS & REMINDERS MODELS
// ----------------------------------------------------------------------------

model NotificationTemplate {
  id           String              @id @default(uuid())
  tenantId     String
  type         NotificationType
  channel      NotificationChannel
  title        String              @db.VarChar(200)
  bodyTemplate String              @db.Text
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([tenantId, type, channel])
  @@index([tenantId])
  @@map("notification_templates")
}

model Notification {
  id             String              @id @default(uuid())
  tenantId       String
  recipientType  String              @db.VarChar(20) // MEMBER, STAFF
  recipientId    String
  type           NotificationType
  channel        NotificationChannel @default(IN_APP)
  title          String              @db.VarChar(255)
  message        String              @db.Text
  status         NotificationStatus  @default(QUEUED)
  idempotencyKey String?             @db.VarChar(150)
  metadata       Json?
  sentAt         DateTime?
  readAt         DateTime?
  errorDetails   String?             @db.Text
  createdAt      DateTime            @default(now())

  @@index([tenantId, recipientId, status])
  @@index([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String?
  memberId       String?
  optOutSms      Boolean  @default(false)
  optOutEmail    Boolean  @default(false)
  optOutWhatsApp Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, memberId])
  @@unique([tenantId, userId])
  @@map("notification_preferences")
}
