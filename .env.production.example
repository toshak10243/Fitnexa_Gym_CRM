NODE_ENV=production
PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=https://trifit.space,https://*.trifit.space

POSTGRES_USER=fitnexa_app
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
POSTGRES_DB=fitnexa
DATABASE_URL=postgresql://fitnexa_app:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/fitnexa?schema=public
DIRECT_URL=postgresql://fitnexa_app:REPLACE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/fitnexa?schema=public

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
REDIS_DB=0

JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
JWT_EXPIRATION=30d
JWT_REFRESH_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
JWT_REFRESH_EXPIRATION=30d
COOKIE_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Fitnexa SaaS Platform"
SMTP_FROM_EMAIL=
APP_URL=https://trifit.space
PLATFORM_DOMAIN=trifit.space
PDF_BROWSER_PATH=/usr/bin/chromium-browser
